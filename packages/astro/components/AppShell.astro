---
import '../styles/obsidiary.css';
import '../styles/app.css';
// Bundled rather than pulled from a CDN: no third-party request, no SRI to go
// stale, and it works offline. katex ships as a transitive dep of the core.
import 'katex/dist/katex.min.css';
import { index, site } from 'virtual:obsidiary';
import { neighboursOf } from 'obsidiary';
import type { Note, Renderer } from 'obsidiary';
import Sidebar from './Sidebar.astro';
import Outline from './Outline.astro';
import Backlinks from './Backlinks.astro';
import Palette from './Palette.astro';
import GraphView from './GraphView.astro';
import CanvasView from './CanvasView.astro';

interface Props {
  note: Note;
  /** Rendered note HTML from `renderer.renderNote(path)`. Empty for canvases. */
  html: string;
  /** Share the page renderer so canvas file nodes reuse its parse cache. */
  renderer?: Renderer;
}

const { note, html, renderer } = Astro.props;

/** Vault paths may contain spaces; GitHub wants them encoded, slashes intact. */
const encodePath = (path: string): string =>
  path.split('/').map(encodeURIComponent).join('/');
const description = note.frontmatter.description;
const summary = typeof description === 'string' ? description : site.description;

/**
 * Where this note sits in its area's reading order, taken from the hub note's
 * own list. `null` when nothing lists it — in which case no strip is drawn at
 * all, rather than a "next" pointing somewhere arbitrary.
 */
const seq = neighboursOf(index, note.path);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{note.title} · {site.title}</title>
    <meta name="description" content={summary} />
    <meta property="og:title" content={note.title} />
    <meta property="og:description" content={summary} />
    <meta property="og:type" content="article" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..600&family=IM+Fell+English+SC&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Runs before first paint: a dark-mode reader must never see a white flash,
      // and a reader in focus mode must never see the panels appear then vanish.
      (() => {
        const stored = localStorage.getItem('obsidiary-theme');
        const prefers = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = stored || prefers;
        if (localStorage.getItem('obsidiary-focus') === '1') {
          document.documentElement.dataset.focus = '1';
        }
      })();
    </script>
  </head>

  <body>
    <a href="#ob-main" class="ob-skip">Skip to content</a>

    <header class="ob-topbar">
      <button class="ob-iconbtn ob-menubtn" id="ob-menu" type="button" aria-label="Toggle sidebar" aria-expanded="false">☰</button>
      <a class="ob-brand" href="/">{site.title}</a>
      <div class="ob-spacer"></div>
      <button
        class="ob-iconbtn"
        id="ob-focus"
        type="button"
        aria-pressed="false"
        aria-label="Focus mode"
        title="Focus mode (z) — hide the panels"
      >◫</button>
      <a class="ob-iconbtn" href="/graph" title="Vault graph" aria-label="Vault graph">◎</a>
      <button class="ob-searchbtn" id="ob-search-trigger" type="button">
        <span aria-hidden="true">⌕</span>
        <span class="ob-searchbtn-label">Search notes</span>
        <span class="ob-kbd">⌘K</span>
      </button>
      <button class="ob-iconbtn" id="ob-theme" type="button" aria-label="Toggle theme" title="Toggle theme (t)">◐</button>
    </header>

    <div class="ob-layout">
      <Sidebar currentPath={note.path} />

      <main class="ob-main" id="ob-main">
        {note.kind === 'canvas' && <CanvasView note={note} renderer={renderer} />}
        {/* An empty wrapper still carries the note's padding, which on a
            slot-only page like /graph pushes the content below the fold. */}
        {note.kind !== 'canvas' && html !== '' && (
          <div class="obsidiary-note">
            {
              seq && (
                <nav class="ob-seq ob-seq--top" aria-label="Position in this series">
                  {seq.prev ? (
                    <a class="ob-seq-t" href={seq.prev.url} rel="prev">
                      <i aria-hidden="true">&larr;</i> {seq.prev.title}
                    </a>
                  ) : (
                    <span />
                  )}
                  {seq.hub && (
                    <a class="ob-seq-up" href={seq.hub.url}>
                      {seq.hub.title} · {seq.position} of {seq.total}
                    </a>
                  )}
                  {seq.next ? (
                    <a class="ob-seq-t ob-seq-t--next" href={seq.next.url} rel="next">
                      {seq.next.title} <i aria-hidden="true">&rarr;</i>
                    </a>
                  ) : (
                    <span />
                  )}
                </nav>
              )
            }

            <article set:html={html} />

            {
              seq && (seq.prev || seq.next) && (
                <nav class="ob-seq-pair" aria-label="Previous and next">
                  {seq.prev ? (
                    <a class="ob-seq-card" href={seq.prev.url} rel="prev">
                      <span class="ob-seq-k">&larr; Previous</span>
                      <span class="ob-seq-n">{seq.prev.title}</span>
                    </a>
                  ) : (
                    <span />
                  )}
                  {seq.next && (
                    <a class="ob-seq-card ob-seq-card--next" href={seq.next.url} rel="next">
                      <span class="ob-seq-k">Next &rarr;</span>
                      <span class="ob-seq-n">{seq.next.title}</span>
                    </a>
                  )}
                </nav>
              )
            }
            {
              (note.mtime || site.source) && (
                <footer class="ob-colophon">
                  {note.mtime && (
                    <span>
                      Last set{' '}
                      <time datetime={new Date(note.mtime).toISOString()}>
                        {new Date(note.mtime).toLocaleDateString('en-GB', {
                          day: 'numeric',
                          month: 'long',
                          year: 'numeric',
                        })}
                      </time>
                    </span>
                  )}
                  {site.source && (
                    <span class="ob-colophon-links">
                      <a href={`${site.source.blobBase}${encodePath(note.path)}`}>
                        View source
                      </a>
                      <a href={`${site.source.editBase}${encodePath(note.path)}`}>
                        Suggest an edit
                      </a>
                      <a href={site.source.homeUrl}>{site.source.repo}</a>
                    </span>
                  )}
                </footer>
              )
            }
          </div>
        )}
        <slot />
      </main>

      <div class="ob-rail">
        <GraphView mode="local" currentPath={note.path} />
        {note.path !== '' && <Outline note={note} />}
        {note.path !== '' && <Backlinks currentPath={note.path} />}
        <slot name="rail" />
      </div>
    </div>

    <Palette />

    <style is:global>
      .ob-skip {
        position: absolute;
        left: -9999px;
        top: 8px;
        z-index: 200;
        background: var(--surface);
        color: var(--text);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius);
        padding: 8px 14px;
      }
      .ob-skip:focus { left: 12px; }
    </style>

    <script>
      // ---------- copy buttons on code blocks ----------
      // Added because a vault is often the place a command or a long prompt
      // lives, and selecting twenty lines of fenced text with a mouse is a
      // small misery. Injected rather than rendered so the markdown pipeline
      // stays a pure markdown-to-HTML transform.
      document.querySelectorAll<HTMLPreElement>('.obsidiary-note pre').forEach((pre) => {
        const code = pre.querySelector('code');
        if (!code) return;

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'ob-copy';
        button.textContent = 'copy';
        button.setAttribute('aria-label', 'Copy code to clipboard');

        let timer: ReturnType<typeof setTimeout> | undefined;
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(code.textContent ?? '');
            button.textContent = 'copied';
            button.dataset.done = 'true';
          } catch {
            // Clipboard is refused on insecure origins; say something true.
            button.textContent = 'select it';
          }
          clearTimeout(timer);
          timer = setTimeout(() => {
            button.textContent = 'copy';
            delete button.dataset.done;
          }, 1600);
        });

        // Wrap rather than append. A button appended inside <pre> sits after
        // the code in normal flow — it lands at the *bottom* of a long block —
        // and anything positioned inside the horizontally scrolling <pre>
        // slides away with the content. The wrapper is the anchor instead.
        const wrap = document.createElement('div');
        wrap.className = 'ob-code';
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);
        wrap.appendChild(button);
      });

      // ---------- wide tables ----------
      // A table is shrink-to-fit. Widening its box with negative margins lets
      // it grow but does not centre it — it sits at the left edge of the wider
      // box and drifts towards the sidebar. So the wrapper takes the width and
      // the table centres inside it, scrolling within its own box when the
      // content is wider than the screen.
      document.querySelectorAll<HTMLTableElement>('.obsidiary-note article > table').forEach((table) => {
        const wrap = document.createElement('div');
        wrap.className = 'ob-table';
        table.parentNode?.insertBefore(wrap, table);
        wrap.appendChild(table);
      });

      // ---------- theme ----------
      const toggleTheme = (): void => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('obsidiary-theme', next);
      };
      document.getElementById('ob-theme')?.addEventListener('click', toggleTheme);

      document.addEventListener('keydown', (e) => {
        const tag = (e.target as HTMLElement | null)?.tagName ?? '';
        const typing = /^(input|textarea|select)$/i.test(tag);
        if (e.metaKey || e.ctrlKey || e.altKey || typing) return;
        if (e.key === 't') toggleTheme();
        else if (e.key === 'z') setFocus(!isFocus());
      });

      // ---------- focus mode ----------
      // Kept on the <html> element and in localStorage, so it survives
      // navigation and is applied before first paint by the inline script above.
      const focusBtn = document.getElementById('ob-focus');
      const setFocus = (on: boolean): void => {
        if (on) document.documentElement.dataset.focus = '1';
        else delete document.documentElement.dataset.focus;
        focusBtn?.setAttribute('aria-pressed', String(on));
        try {
          localStorage.setItem('obsidiary-focus', on ? '1' : '0');
        } catch {
          /* private browsing — focus mode just won't persist */
        }
      };
      const isFocus = (): boolean => document.documentElement.dataset.focus === '1';
      focusBtn?.setAttribute('aria-pressed', String(isFocus()));
      focusBtn?.addEventListener('click', () => setFocus(!isFocus()));

      // ---------- sidebar drawer ----------
      const menu = document.getElementById('ob-menu');
      const setSidebar = (open: boolean): void => {
        document.body.dataset.sidebar = open ? 'open' : 'closed';
        menu?.setAttribute('aria-expanded', String(open));
      };
      menu?.addEventListener('click', () =>
        setSidebar(document.body.dataset.sidebar !== 'open'),
      );
      document.getElementById('ob-sidebar')?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setSidebar(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.body.dataset.sidebar === 'open') setSidebar(false);
      });

      // ---------- folder collapse ----------
      const TREE_KEY = 'obsidiary-tree';
      const readOpen = (): Set<string> => {
        try {
          return new Set(JSON.parse(localStorage.getItem(TREE_KEY) ?? '[]') as string[]);
        } catch {
          return new Set();
        }
      };
      const openFolders = readOpen();

      document.querySelectorAll<HTMLLIElement>('.ob-folder').forEach((li) => {
        const path = li.dataset.path ?? '';
        // The server marked ancestors of the current note as open. Honour that
        // without persisting it, or every visit would permanently expand more
        // of the tree until nothing was ever collapsed again.
        const isAncestor = li.dataset.open === 'true';
        li.dataset.open = String(openFolders.has(path) || isAncestor);

        // A folder with an index note wraps its caret and link in `.ob-folder-row`;
        // one without has the caret directly on the `li`. Match both, or the
        // caret silently stops toggling for every folder that has a hub note.
        const toggle = li.querySelector<HTMLButtonElement>(
          ':scope > .ob-folder-toggle, :scope > .ob-folder-row > .ob-folder-toggle',
        );

        toggle?.addEventListener('click', () => {
          const next = li.dataset.open !== 'true';
          li.dataset.open = String(next);
          toggle.setAttribute('aria-expanded', String(next));
          next ? openFolders.add(path) : openFolders.delete(path);
          try {
            localStorage.setItem(TREE_KEY, JSON.stringify([...openFolders]));
          } catch {
            /* storage unavailable — collapse still works for this session */
          }
        });
      });

      // Keep the current note in view in a long tree — but only when it isn't
      // already visible. Yanking a short tree to centre on every page load reads
      // as a glitch.
      const current = document.querySelector<HTMLElement>('.ob-tree [aria-current="page"]');
      const sidebar = document.getElementById('ob-sidebar');
      if (current && sidebar) {
        const item = current.getBoundingClientRect();
        const frame = sidebar.getBoundingClientRect();
        if (item.top < frame.top + 8 || item.bottom > frame.bottom - 8) {
          current.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
        }
      }

      // ---------- outline scroll-spy ----------
      const outlineLinks = [...document.querySelectorAll<HTMLAnchorElement>('#ob-outline a')];
      if (outlineLinks.length > 0) {
        const headings = outlineLinks
          .map((a) => document.getElementById(a.dataset.slug ?? ''))
          .filter((el): el is HTMLElement => Boolean(el));

        let queued = false;
        const spy = (): void => {
          queued = false;
          let activeIndex = 0;
          for (let i = 0; i < headings.length; i++) {
            const top = headings[i]?.getBoundingClientRect().top ?? 0;
            if (top <= 120) activeIndex = i;
            else break;
          }
          outlineLinks.forEach((a, i) => a.classList.toggle('is-active', i === activeIndex));
        };
        addEventListener(
          'scroll',
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(spy);
          },
          { passive: true },
        );
        spy();
      }

      // ---------- hover previews ----------
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const cache = new Map<string, string | null>();
        let popover: HTMLDivElement | null = null;
        let showTimer: number | undefined;
        let hideTimer: number | undefined;

        const panel = (): HTMLDivElement => {
          if (!popover) {
            popover = document.createElement('div');
            popover.className = 'ob-preview';
            popover.dataset.show = 'false';
            document.body.appendChild(popover);
          }
          return popover;
        };

        const fetchPreview = async (href: string): Promise<string | null> => {
          if (cache.has(href)) return cache.get(href) ?? null;
          try {
            const res = await fetch(href);
            if (!res.ok) throw new Error(String(res.status));
            const parsed = new DOMParser().parseFromString(await res.text(), 'text/html');
            const article = parsed.querySelector('.obsidiary-note article');
            const html = article?.innerHTML ?? null;
            cache.set(href, html);
            return html;
          } catch {
            cache.set(href, null);
            return null;
          }
        };

        const hide = (): void => {
          clearTimeout(showTimer);
          hideTimer = window.setTimeout(() => {
            if (popover) popover.dataset.show = 'false';
          }, 120);
        };

        document.querySelectorAll<HTMLAnchorElement>('.obsidiary-note a.internal-link').forEach((link) => {
          link.addEventListener('mouseenter', () => {
            clearTimeout(hideTimer);
            const href = link.getAttribute('href')?.split('#')[0];
            if (!href) return;

            showTimer = window.setTimeout(async () => {
              const html = await fetchPreview(href);
              if (!html) return;

              const el = panel();
              el.innerHTML = html;

              const rect = link.getBoundingClientRect();
              const width = el.offsetWidth || 380;
              const left = Math.min(
                Math.max(8, rect.left + scrollX),
                scrollX + innerWidth - width - 8,
              );
              // Flip above the link when the panel's full height won't fit
              // below, then clamp so it can never run off the top either.
              const height = el.offsetHeight || 320;
              const below = innerHeight - rect.bottom > height + 16;
              const top = below
                ? rect.bottom + scrollY + 8
                : rect.top + scrollY - height - 8;
              el.style.left = `${left}px`;
              el.style.top = `${Math.max(scrollY + 8, top)}px`;
              el.dataset.show = 'true';
            }, 350);
          });

          link.addEventListener('mouseleave', hide);
        });
      }
    </script>
  </body>
</html>
