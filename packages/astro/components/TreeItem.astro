---
import type { TreeNode } from 'obsidiary';

interface Props {
  nodes: TreeNode[];
  currentPath: string;
  open: string[];
}

const { nodes, currentPath, open } = Astro.props;
---

<ul>
  {
    nodes.map((node) =>
      node.type === 'folder' ? (
        <li class="ob-folder" data-path={node.path} data-open={open.includes(node.path) ? 'true' : 'false'}>
          <button class="ob-folder-toggle" type="button" aria-expanded={open.includes(node.path)}>
            <span class="ob-caret" aria-hidden="true">▶</span>
            <span class="ob-name">{node.name}</span>
          </button>
          <Astro.self nodes={node.children} currentPath={currentPath} open={open} />
        </li>
      ) : (
        <li>
          <a href={node.url} aria-current={node.path === currentPath ? 'page' : undefined}>
            <span class="ob-name">{node.title}</span>
          </a>
        </li>
      ),
    )
  }
</ul>
