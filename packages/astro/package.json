{
  "name": "@obsidiary/astro",
  "version": "0.1.6",
  "description": "Astro integration for Obsidiary — point it at a vault directory and get a site.",
  "license": "MIT",
  "author": "Chitransh Saxena",
  "homepage": "https://obsidiary.pulsar-projects.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chitransh-Saxena/obsidiary.git",
    "directory": "packages/astro"
  },
  "bugs": "https://github.com/Chitransh-Saxena/obsidiary/issues",
  "keywords": ["obsidian", "astro", "astro-integration", "digital-garden", "backlinks", "static-site"],
  "engines": { "node": ">=22.12.0" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles/obsidiary.css",
    "./app.css": "./styles/app.css",
    "./components/*": "./components/*",
    "./routes/*": "./routes/*"
  },
  "files": ["dist", "styles", "components", "routes", "README.md"],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "obsidiary": "0.1.2"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0"
  }
}
