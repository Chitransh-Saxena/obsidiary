{
  // Cloudflare Workers, serving the built site as static assets.
  // Deploy with:  npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-notes-site",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
