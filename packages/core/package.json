{
  "name": "obsidiary",
  "version": "0.1.0",
  "description": "Isomorphic core for Obsidiary — parses an Obsidian vault into notes, links and a graph. Runs at build time in Node and at runtime in the browser.",
  "license": "MIT",
  "author": "Chitransh Saxena",
  "homepage": "https://obsidiary.pulsar-projects.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chitransh-Saxena/obsidiary.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/Chitransh-Saxena/obsidiary/issues",
  "engines": { "node": ">=22.12.0" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "keywords": ["obsidian", "wikilink", "markdown", "digital-garden", "backlinks", "remark"],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "github-slugger": "^2.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.6.1"
  }
}
