---
import '@obsidiary/astro/styles.css';
import Drollery from '../components/Drollery.astro';

// Public endpoint, not a secret — the default keeps the counters working for
// anyone who builds this site without configuring anything.
const ADOPTION_URL =
  import.meta.env.PUBLIC_ADOPTION_URL ?? 'https://obsidiary-api.pulsar-projects.org';
const REPO = 'https://github.com/Chitransh-Saxena/obsidiary';

const forAnyone = [
  {
    title: 'You already write in Obsidian',
    body: 'Obsidian Publish is $10 a month. This is free, the output is yours, and your notes never leave a folder you control.',
  },
  {
    title: 'A thinking log where the links are the point',
    body: 'Backlinks with the surrounding sentence, a real graph, transclusion. If a blog would flatten what you are doing, this will not.',
  },
  {
    title: 'Documentation that lives with the code',
    body: 'Write docs in Obsidian, publish them from the repository they describe. No CMS, no export step, no second copy to drift.',
  },
  {
    title: 'Notes meant to be read, not merely kept',
    body: 'Course material, teaching notes, reading notes. Canvas files carry the diagrams; embeds mean a thing is written once and reused.',
  },
  {
    title: 'Publishing a vault you do not own',
    body: 'Point it at any public repository — a study group’s shared notes, a spec, someone’s open wiki. Nothing to fork, nothing to maintain.',
  },
  {
    title: 'Reading a vault with zero commitment',
    body: 'The live view renders any public vault in your browser. No clone, no build, no account. Useful before committing to anything.',
  },
];

const forMe = [
  {
    icon: 'aviator' as const,
    label: 'a drone, hovering',
    body: 'FPV drone build logs — canvas files for wiring and frame layouts, embeds so a parts list is written once and reused across every build.',
  },
  {
    icon: 'lutenist' as const,
    label: 'a figure playing a guitar',
    body: 'Guitar: song breakdowns, practice logs, and the theory I keep having to re-learn from scratch.',
  },
  {
    icon: 'juggler' as const,
    label: 'a figure keeping a football up',
    body: 'Football — the trivela, and why a ball bends the way it does. It became a whole other project once the notes got long enough.',
  },
  {
    icon: 'limner' as const,
    label: 'a camera',
    body: 'Photography: shoot notes, the settings that worked, and gear assessed honestly after using it rather than after buying it.',
  },
  {
    icon: 'reader' as const,
    label: 'a book, its leaf turning',
    body: 'Reading notes that feed the bookshelf on my portfolio, instead of rotting quietly in a folder.',
  },
];

const notFor = [
  ['Private notes', 'A public repository means a public site. Selective publishing exists, but the safe answer is a separate private repository.'],
  ['Editing on the web', 'There is no web editor and there will not be one. Obsidian — or any text editor — is the editor.'],
  ['Being a blog engine', 'No comments, no newsletter, no scheduling. If you want a blog, write a blog.'],
];

const hosts = [
  ['Cloudflare', 'npx wrangler deploy', 'unlimited', 'free', 'allowed', true],
  ['Vercel', 'import the repository', '100 GB', 'free', 'not on free', false],
  ['Netlify', 'import the repository', '100 GB', 'free', 'allowed', false],
  ['GitHub Pages', 'Settings → Pages → Actions', '100 GB soft', 'free', 'not on free', false],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Obsidiary — a device for publishing private libraries</title>
    <meta
      name="description"
      content="Free and open source. Turn any Obsidian vault into a fast, linked, searchable website — with your notes in their own repository and upgrades that are npm update, not a merge conflict."
    />
    <meta property="og:title" content="Obsidiary" />
    <meta property="og:description" content="Publish an Obsidian vault as a fast, linked, free website." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..600&family=IM+Fell+English+SC&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('obsidiary-theme');
        const prefers = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = stored || prefers;
      })();
    </script>
  </head>

  <body class="cx">
    <!-- ─────────── running head ─────────── -->
    <header class="cx-head">
      <span class="cx-head-l">Obsidiary</span>
      <span class="cx-head-c">a device for the publishing of private libraries</span>
      <nav class="cx-head-r">
        <a href="/docs">Docs</a>
        <span class="cx-sep">·</span>
        <a href="/live">Live</a>
        <span class="cx-sep">·</span>
        <a href="https://notes.pulsar-projects.org">A vault</a>
        <span class="cx-sep">·</span>
        <a href={REPO}>Source</a>
        <button id="cx-theme" type="button" aria-label="Toggle theme">☾</button>
      </nav>
    </header>

    <!-- ─────────── title page ─────────── -->
    <section class="cx-title">
      <div class="cx-title-plate">
        <hr class="cx-rule cx-rule--double" />
        <p class="cx-imprint">Free · Open source · MIT</p>
        <h1 class="cx-name">Obsidiary</h1>
        <p class="cx-sub">
          Whereby a folder of <i>Obsidian</i> markdown is made into a swift, linked and
          searchable site: with <span class="cx-rub">wikilinks</span>,
          <span class="cx-rub">transclusion</span>, <span class="cx-rub">callouts</span>,
          <span class="cx-rub">backlinks</span>, a <span class="cx-rub">graph</span>, and
          <code>.canvas</code> files that truly render.
        </p>
        <hr class="cx-rule" />
        <p class="cx-standfirst">
          <b>Obsidian stays your editor.</b> This is only the other half — the part that puts
          a vault on the web and makes it legible to someone who does not have your vault.
        </p>

        <!-- the borrower's card -->
        <div class="cx-card">
          <div class="cx-card-head">
            <span>Obsidiary · to install</span>
            <span class="cx-callno">005.74 OBS</span>
          </div>
          <div class="cx-card-body">
            <code id="cx-cmd">npm create obsidiary@latest</code>
            <button id="cx-copy" type="button" aria-label="Copy command">copy</button>
          </div>
          <div class="cx-card-foot">
            <a class="cx-go" href="/live">
              <span>Read any vault, unbound</span>
              <i class="cx-go-arrow" aria-hidden="true">&rarr;</i>
            </a>
            <a class="cx-quiet" href="/docs">The setter's guide</a>
          </div>
        </div>

        <p class="cx-seen">
          <span class="cx-seen-t">Seen in the wild —</span>
          <a href="https://notes.pulsar-projects.org">my own notes</a> run on this,
          set from <a href="https://github.com/Chitransh-Saxena/notes">a repository holding
          nothing but markdown</a>.
        </p>
      </div>

      <!-- engraved plate -->
      <figure class="cx-plate">
        <div class="cx-plate-frame">
          <canvas id="cx-graph"></canvas>
        </div>
        <figcaption>
          <span class="cx-fig">Fig. I.</span> The link-graph of a small vault, drawn by the
          engine itself.
        </figcaption>
      </figure>
    </section>

    <!-- ─────────── circulation record ─────────── -->
    <section class="cx-circ" id="cx-circ" hidden>
      <p class="cx-slip-label">Circulation record</p>
      <dl>
        <div><dt>stars</dt><dd data-counter="stars">—</dd></div>
        <div><dt>forks</dt><dd data-counter="forks">—</dd></div>
        <div><dt>issued / week</dt><dd data-counter="downloadsWeek">—</dd></div>
        <div><dt>issued / month</dt><dd data-counter="downloadsMonth">—</dd></div>
      </dl>
      <p class="cx-slip-note">Kept from public record only — npm and GitHub. This library keeps no telemetry.</p>
    </section>

    <!-- ─────────── cap. I — the argument ─────────── -->
    <section class="cx-chap">
      <p class="cx-chapno">Cap. I</p>
      <h2 class="cx-chaph">Of the uses to which it is fairly put</h2>
      <hr class="cx-rule cx-rule--double" />

      <div class="cx-cols">
        <p class="cx-drop">
          There are honest reasons to publish a vault and dishonest ones, and it is worth
          saying plainly which are which before you spend an afternoon on it.
        </p>
        {
          forAnyone.map((item) => (
            <p class="cx-entry">
              <span class="cx-entry-t">{item.title}.</span> {item.body}
            </p>
          ))
        }
      </div>
      <p class="cx-catch">and of the author's own use &rarr;</p>
    </section>

    <!-- ─────────── cap. II — dogfood + honesty ─────────── -->
    <section class="cx-chap cx-chap--two">
      <div>
        <p class="cx-chapno">Cap. II</p>
        <h2 class="cx-chaph">Of the author's own shelves</h2>
        <hr class="cx-rule" />
        <p class="cx-lead">
          I built this because I wanted it. Engineering notes and whatever I am currently
          figuring out live at my own domain; alongside them, these.
        </p>
        <ul class="cx-shelves">
          {
            forMe.map((item) => (
              <li>
                <Drollery name={item.icon} label={item.label} />
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="cx-chapno cx-chapno--rub">Caveat</p>
        <h2 class="cx-chaph">Wherein it will not serve</h2>
        <hr class="cx-rule" />
        <dl class="cx-caveats">
          {
            notFor.map(([title, body]) => (
              <div>
                <dt>{title}</dt>
                <dd>{body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ─────────── cap. III — the setting forth ─────────── -->
    <section class="cx-chap">
      <p class="cx-chapno">Cap. III</p>
      <h2 class="cx-chaph">The setting-forth, in three motions</h2>
      <hr class="cx-rule cx-rule--double" />

      <ol class="cx-recipe">
        <li>
          <h3>Scaffold</h3>
          <pre><code>npm create obsidiary@latest my-notes</code></pre>
          <p>No dependencies, and a single question: is your vault a folder here, or a repository elsewhere?</p>
        </li>
        <li>
          <h3>Point it at the notes</h3>
          <pre><code>{`obsidiary({
  vault: './vault',       // a folder here
  // repo: 'you/notes',   // …or its own repository
})`}</code></pre>
          <p>Notes in their own repository is the whole idea — the engine is a dependency, never a fork of your writing.</p>
        </li>
        <li>
          <h3>Set it forth</h3>
          <pre><code>npx wrangler deploy</code></pre>
          <p>Or hand the repository to Vercel or Netlify, or turn on GitHub Pages.</p>
        </li>
      </ol>
      <p class="cx-catch">a table of presses &rarr;</p>
    </section>

    <!-- ─────────── the table ─────────── -->
    <section class="cx-chap">
      <p class="cx-chapno">Tabula</p>
      <h2 class="cx-chaph">Of presses that ask nothing</h2>
      <hr class="cx-rule cx-rule--double" />

      <table class="cx-table">
        <thead>
          <tr><th>Press</th><th>Command</th><th>Bandwidth</th><th>Domain</th><th>Commerce</th></tr>
        </thead>
        <tbody>
          {
            hosts.map(([name, cmd, bw, dom, com, best]) => (
              <tr class={best ? 'is-best' : ''}>
                <th scope="row">
                  {name}
                  {best && <span class="cx-mark">recommended</span>}
                </th>
                <td><code>{cmd}</code></td>
                <td>{bw}</td>
                <td>{dom}</td>
                <td class={com === 'not on free' ? 'cx-no' : ''}>{com}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="cx-foot-note">
        Cloudflare is the recommendation: unlimited bandwidth, free custom domains, and no
        restriction on commercial use. Vercel and GitHub Pages cap at 100 GB <i>and</i> forbid
        commercial sites.
      </p>
    </section>

    <!-- ─────────── the apology ─────────── -->
    <section class="cx-chap cx-chap--apology">
      <p class="cx-chapno cx-chapno--rub">Apologia</p>
      <h2 class="cx-chaph">Quartz is good. Use it, unless…</h2>
      <hr class="cx-rule" />
      <ol class="cx-numbered">
        <li>
          <b>You want your notes in their own repository.</b> Quartz has no first-class support
          for it; everyone hand-rolls a submodule. Here it is one line of configuration.
        </li>
        <li>
          <b>You are weary of upgrade conflicts.</b> Quartz ships a <code>content/</code> folder
          upstream, so most updates end in a merge inside your own writing. Distribution as a
          package was proposed and declined. Here the engine is a dependency:
          <code>npm update</code>, and nothing to resolve.
        </li>
        <li>
          <b>You want it to feel like the application.</b> Sidebar, outline, backlinks with
          context, ⌘K, hover previews, graph, canvas — not a documentation template.
        </li>
      </ol>
    </section>

    <!-- ─────────── colophon ─────────── -->
    <footer class="cx-colophon">
      <hr class="cx-rule cx-rule--double" />
      <p class="cx-orn" aria-hidden="true">❦</p>

      <p class="cx-thanks">
        <span class="cx-thanks-t">With thanks.</span> Obsidiary exists because
        <a href="https://obsidian.md">Obsidian</a> exists. The vault, the wikilink, the
        canvas, and the whole idea of a local-first library that stays yours — all of it
        is theirs, and this was built in admiration of it. Obsidiary is only a way to put
        such a library on the web. It is not affiliated with, endorsed by, or a
        replacement for Obsidian, and you should keep using Obsidian to write.
      </p>

      <p class="cx-colo-body">
        <span class="cx-colo-title">Colophon.</span> Obsidiary was written by
        <b>Chitransh Saxena</b> and is given freely under the MIT licence. Set in
        <i>Newsreader</i>, its optical size drawn afresh at each rank of type; with
        initials and running heads in <i>IM&nbsp;Fell&nbsp;English</i>, cut by Peter de
        Walpergen for John Fell in the seventeenth century. Composed in TypeScript,
        impressed at Cloudflare's edge.
      </p>
      <nav class="cx-colo-links">
        <a href="/docs">Documentation</a>
        <a href="/live">Live view</a>
        <a href="/graph">Graph</a>
        <a href={REPO}>Source</a>
      </nav>
    </footer>

    <script define:vars={{ ADOPTION_URL }}>
      if (ADOPTION_URL) {
        fetch(ADOPTION_URL)
          .then((r) => (r.ok ? r.json() : null))
          .then((data) => {
            if (!data) return;
            const strip = document.getElementById('cx-circ');
            let any = false;
            for (const el of document.querySelectorAll('[data-counter]')) {
              const value = data[el.getAttribute('data-counter')];
              // A zero is honest but reads worse than silence on a new project.
              // The record appears by itself once there is something to record.
              if (typeof value === 'number' && value > 0) {
                el.textContent = value.toLocaleString();
                any = true;
              } else {
                el.closest('div')?.remove();
              }
            }
            if (any && strip) strip.hidden = false;
          })
          .catch(() => {});
      }
    </script>

    <script>
      import { boundsOf, createSimulation } from 'obsidiary';

      document.getElementById('cx-theme')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('obsidiary-theme', next);
      });

      const copyBtn = document.getElementById('cx-copy');
      copyBtn?.addEventListener('click', async () => {
        const text = document.getElementById('cx-cmd')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.textContent = 'copied';
          setTimeout(() => (copyBtn.textContent = 'copy'), 1400);
        } catch {
          copyBtn.textContent = 'select it';
        }
      });

      // The plate is the product's own force simulation — the same code that
      // lays out a real vault's graph, engraved here on a miniature.
      const canvas = document.getElementById('cx-graph') as HTMLCanvasElement | null;
      const ctx = canvas?.getContext('2d');
      if (canvas && ctx) {
        const ids = [
          'index', 'Zettelkasten', 'Wikilinks', 'Canvas', 'Reading',
          'Drones', 'Guitar', 'Astro', 'Graph', 'Embeds',
        ];
        const links = [
          ['index', 'Zettelkasten'], ['index', 'Wikilinks'], ['index', 'Reading'],
          ['Wikilinks', 'Embeds'], ['Wikilinks', 'Zettelkasten'], ['Canvas', 'Graph'],
          ['Zettelkasten', 'Graph'], ['Reading', 'Drones'], ['Reading', 'Guitar'],
          ['Astro', 'Canvas'], ['Astro', 'Embeds'], ['Graph', 'index'],
        ].map(([source, target]) => ({ source: source!, target: target! }));

        const sim = createSimulation(ids, links, { linkDistance: 58, repulsion: 1100 });
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

        let w = 0;
        let h = 0;
        const resize = () => {
          const rect = canvas.getBoundingClientRect();
          const dpr = devicePixelRatio || 1;
          w = rect.width;
          h = rect.height;
          canvas.width = Math.max(1, Math.round(w * dpr));
          canvas.height = Math.max(1, Math.round(h * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };

        const paint = () => {
          const s = getComputedStyle(document.documentElement);
          const rubric = s.getPropertyValue('--cx-rubric').trim() || '#9c2b21';
          const ink = s.getPropertyValue('--cx-ink-3').trim() || '#6f6857';
          const rule = s.getPropertyValue('--cx-rule').trim() || '#cfc5ae';

          const b = boundsOf(sim.nodes, 30);
          const scale = Math.min(w / (b.width || 1), h / (b.height || 1), 1.5);
          const tx = w / 2 - ((b.minX + b.maxX) / 2) * scale;
          const ty = h / 2 - ((b.minY + b.maxY) / 2) * scale;
          const at = (n: { x: number; y: number }) => ({ x: n.x * scale + tx, y: n.y * scale + ty });

          ctx.clearRect(0, 0, w, h);
          ctx.strokeStyle = rule;
          ctx.lineWidth = 0.9;
          for (const link of sim.links) {
            const a = sim.nodes.find((n) => n.id === link.source);
            const c = sim.nodes.find((n) => n.id === link.target);
            if (!a || !c) continue;
            const p1 = at(a);
            const p2 = at(c);
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
          // Engraved dots: an open ring, filled only for the focus — closer to a
          // printed plate than the solid discs of a screen graph.
          for (const node of sim.nodes) {
            const p = at(node);
            const r = Math.min(7.5, 3 + Math.sqrt(node.degree) * 1.5);
            ctx.beginPath();
            ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
            if (node.id === 'index') {
              ctx.fillStyle = rubric;
              ctx.fill();
            } else {
              ctx.fillStyle = s.getPropertyValue('--cx-paper').trim() || '#f6f1e7';
              ctx.fill();
              ctx.strokeStyle = ink;
              ctx.lineWidth = 1.1;
              ctx.stroke();
            }
          }
        };

        resize();
        if (reduce) {
          sim.run();
          paint();
        } else {
          sim.run(30);
          const step = () => {
            const alive = sim.tick();
            paint();
            if (alive) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
        addEventListener('resize', () => {
          resize();
          paint();
        });
        new MutationObserver(paint).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      }
    </script>

    <style is:global>
      [hidden] { display: none !important; }

      /* ══════════ the leaf ══════════ */
      /* The codex palette is the product's core theme now, defined once in
         obsidiary.css. These are aliases onto it, so the title page and the
         reading app can never drift apart. */
      :root {
        --cx-paper: var(--bg);
        --cx-paper-2: var(--surface-2);
        --cx-ink: var(--text);
        --cx-ink-2: var(--text-2);
        --cx-ink-3: var(--text-3);
        --cx-ink-4: var(--text-4);
        --cx-rubric: var(--accent);
        --cx-rule: var(--border-strong);
        --cx-rule-soft: var(--border);

        --cx-serif: var(--font-sans);
        --cx-fell: var(--font-display);
        --cx-mono: var(--font-mono);

        --cx-measure: 33rem;
        --cx-page: 62rem;
      }

      .cx {
        margin: 0;
        background: var(--cx-paper);
        color: var(--cx-ink);
        font-family: var(--cx-serif);
        font-size: 19px;
        line-height: 1.62;
        font-feature-settings: "onum" 1, "kern" 1, "liga" 1;
        font-optical-sizing: auto;
        font-variation-settings: "opsz" 16;
        -webkit-font-smoothing: antialiased;
      }

      /* The grain comes from the core theme's body::before, which sits behind
         the content — nothing here needs lifting. */

      .cx code { font-family: var(--cx-mono); font-size: 0.79em; }
      .cx a { color: var(--cx-rubric); text-decoration: none; }
      .cx a:hover { text-decoration: underline; text-underline-offset: 3px; }
      .cx i, .cx em { font-style: italic; }

      /* ══════════ rules ══════════ */
      .cx-rule {
        border: 0;
        border-top: 1px solid var(--cx-rule);
        margin: 1.4rem 0;
      }
      .cx-rule--double {
        border-top: 3px double var(--cx-rule);
        border-bottom: 0;
        height: 0;
      }

      /* ══════════ running head ══════════ */
      .cx-head {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: baseline;
        gap: 18px;
        max-width: var(--cx-page);
        margin: 0 auto;
        padding: 22px clamp(20px, 5vw, 34px) 12px;
        border-bottom: 1px solid var(--cx-rule);
        font-family: var(--cx-fell);
        font-size: 0.72rem;
        letter-spacing: 0.07em;
        text-transform: lowercase;
      }
      .cx-head-l { color: var(--cx-ink); }
      .cx-head-c { color: var(--cx-ink-4); font-style: italic; text-align: center; }
      .cx-head-r { justify-self: end; display: flex; align-items: baseline; gap: 8px; }
      .cx-head-r a { color: var(--cx-ink-3); }
      .cx-head-r a:hover { color: var(--cx-rubric); }
      .cx-sep { color: var(--cx-rule); }
      .cx-head-r button {
        font: inherit;
        font-size: 0.85rem;
        line-height: 1;
        color: var(--cx-ink-3);
        background: none;
        border: 1px solid var(--cx-rule);
        border-radius: 2px;
        padding: 3px 7px;
        margin-left: 6px;
        cursor: pointer;
      }
      .cx-head-r button:hover { color: var(--cx-rubric); border-color: var(--cx-rubric); }

      /* ══════════ title page ══════════ */
      .cx-title {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
        gap: clamp(30px, 5vw, 62px);
        align-items: start;
        max-width: var(--cx-page);
        margin: 0 auto;
        padding: clamp(34px, 6vh, 62px) clamp(20px, 5vw, 34px) clamp(30px, 5vh, 54px);
      }

      .cx-imprint {
        font-family: var(--cx-fell);
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--cx-ink-4);
        text-align: center;
        margin: 0.9rem 0 1.1rem;
      }

      /* The title is set at reading scale. Its authority comes from the rules
         and the letterspacing, not from being enormous. */
      .cx-name {
        font-family: var(--cx-fell);
        font-size: clamp(1.85rem, 3.6vw, 2.5rem);
        font-weight: 400;
        letter-spacing: 0.1em;
        line-height: 1.1;
        text-align: center;
        color: var(--cx-ink);
        margin: 0 0 0.55rem;
      }

      .cx-sub {
        font-size: 1.12rem;
        line-height: 1.55;
        text-align: center;
        color: var(--cx-ink-2);
        margin: 0 auto 0.2rem;
        max-width: 30rem;
        text-wrap: balance;
        /* A high optical size gives the finer, higher-contrast cut a title page
           wants — the same family, drawn for display rather than for reading. */
        font-variation-settings: "opsz" 46;
        font-weight: 380;
        letter-spacing: 0.002em;
      }
      .cx-rub { color: var(--cx-rubric); font-style: italic; }

      .cx-standfirst {
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--cx-ink-2);
        border-left: 2px solid var(--cx-rubric);
        padding-left: 14px;
        margin: 0 0 1.5rem;
      }
      .cx-standfirst b { font-weight: 600; color: var(--cx-ink); }

      /* ── borrower's card ── */
      .cx-card {
        border: 1px solid var(--cx-rule);
        background: var(--cx-paper-2);
        box-shadow: 2px 3px 0 var(--cx-rule-soft);
      }
      .cx-card-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        padding: 7px 13px;
        border-bottom: 1px solid var(--cx-rule);
        font-family: var(--cx-fell);
        font-size: 0.66rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--cx-ink-4);
      }
      .cx-callno { font-family: var(--cx-mono); letter-spacing: 0.04em; }
      .cx-card-body {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px;
        /* ruled like a card, so the command sits on a printed line */
        background-image: repeating-linear-gradient(
          transparent 0 26px,
          var(--cx-rule-soft) 26px 27px
        );
      }
      .cx-card-body code { flex: 1; font-size: 0.83rem; color: var(--cx-ink); }
      .cx-card-body button {
        font-family: var(--cx-fell);
        font-size: 0.66rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--cx-ink-3);
        background: var(--cx-paper);
        border: 1px solid var(--cx-rule);
        border-radius: 2px;
        padding: 4px 9px;
        cursor: pointer;
      }
      .cx-card-body button:hover { color: var(--cx-rubric); border-color: var(--cx-rubric); }
      .cx-card-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        padding: 12px 13px;
        border-top: 1px solid var(--cx-rule);
        font-size: 0.86rem;
      }

      /* The chief action, given the same double-ruled frame as the plate above
         so it reads as part of the page rather than a button dropped onto it.
         Selector needs `.cx a.cx-go`: the base `.cx a` rule is (0,1,1) and would
         otherwise win over a bare `.cx-go` (0,1,0), painting rubric on rubric. */
      .cx a.cx-go {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin: 4px;                    /* room for the offset rule */
        font-family: var(--cx-fell);
        font-size: 0.78rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--cx-paper);
        background: var(--cx-rubric);
        border: 0;
        border-radius: 1px;
        outline: 1px solid var(--cx-rubric);
        outline-offset: 3px;
        padding: 12px 20px;
        transition: background 170ms ease, outline-offset 170ms ease, transform 170ms ease;
      }
      .cx a.cx-go:hover {
        color: var(--cx-paper);
        text-decoration: none;
        background: color-mix(in srgb, var(--cx-rubric) 86%, #000);
        outline-offset: 5px;
        transform: translateY(-1px);
      }
      .cx a.cx-go:active { transform: translateY(1px); outline-offset: 2px; }
      .cx-go-arrow { font-style: normal; transition: transform 170ms ease; }
      .cx a.cx-go:hover .cx-go-arrow { transform: translateX(4px); }

      .cx-quiet { font-style: italic; color: var(--cx-ink-3); }
      .cx-quiet:hover { color: var(--cx-rubric); }

      .cx-seen {
        margin: 1.1rem 0 0;
        font-size: 0.9rem;
        line-height: 1.55;
        color: var(--cx-ink-3);
        font-variation-settings: "opsz" 14;
      }
      .cx-seen-t {
        font-family: var(--cx-fell);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--cx-ink-4);
      }

      @media (prefers-reduced-motion: reduce) {
        .cx a.cx-go, .cx a.cx-go:hover, .cx a.cx-go:active { transition: none; transform: none; }
      }

      /* ── engraved plate ── */
      .cx-plate { margin: 0; padding-top: 0.6rem; }
      .cx-plate-frame {
        border: 1px solid var(--cx-ink-3);
        outline: 1px solid var(--cx-rule);
        outline-offset: 3px;
        background: var(--cx-paper-2);
        padding: 10px;
      }
      .cx-plate canvas {
        display: block;
        width: 100%;
        aspect-ratio: 1 / 0.94;
      }
      .cx-plate figcaption {
        margin-top: 14px;
        font-size: 0.84rem;
        font-style: italic;
        line-height: 1.5;
        color: var(--cx-ink-3);
        text-align: center;
      }
      .cx-fig {
        font-family: var(--cx-fell);
        font-style: normal;
        letter-spacing: 0.06em;
        color: var(--cx-ink-2);
      }

      /* ══════════ circulation record ══════════ */
      .cx-circ {
        max-width: var(--cx-page);
        margin: 0 auto;
        padding: 0 clamp(20px, 5vw, 34px) 30px;
      }
      .cx-slip-label, .cx-slip-note {
        font-family: var(--cx-fell);
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--cx-ink-4);
        margin: 0 0 10px;
      }
      .cx-slip-note { margin: 10px 0 0; letter-spacing: 0.06em; text-transform: none; font-style: italic; }
      .cx-circ dl {
        display: flex;
        flex-wrap: wrap;
        gap: clamp(20px, 5vw, 54px);
        margin: 0;
        padding: 16px 20px;
        border: 1px solid var(--cx-rule);
        border-left: 3px double var(--cx-rule);
        background: var(--cx-paper-2);
      }
      .cx-circ dt {
        font-family: var(--cx-fell);
        font-size: 0.64rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--cx-ink-4);
      }
      .cx-circ dd {
        font-family: var(--cx-fell);
        font-size: 1.35rem;
        margin: 2px 0 0;
        color: var(--cx-ink);
      }

      /* ══════════ chapters ══════════ */
      .cx-chap {
        max-width: var(--cx-page);
        margin: 0 auto;
        padding: clamp(34px, 6vh, 58px) clamp(20px, 5vw, 34px);
      }
      .cx-chapno {
        font-family: var(--cx-fell);
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--cx-ink-4);
        margin: 0 0 0.3rem;
      }
      .cx-chapno--rub { color: var(--cx-rubric); }
      .cx-chaph {
        font-family: var(--cx-fell);
        font-size: clamp(1.15rem, 2vw, 1.4rem);
        font-weight: 400;
        letter-spacing: 0.03em;
        line-height: 1.25;
        color: var(--cx-ink);
        margin: 0;
      }
      .cx-lead {
        color: var(--cx-ink-2);
        font-style: italic;
        margin: 0 0 1rem;
        font-variation-settings: "opsz" 30;
      }

      /* two columns, as an opening should be */
      .cx-cols {
        columns: 2;
        column-gap: clamp(28px, 5vw, 52px);
        column-rule: 1px solid var(--cx-rule-soft);
        margin-top: 0.4rem;
      }
      .cx-cols p { margin: 0 0 0.95rem; break-inside: avoid; }
      .cx-entry-t {
        font-family: var(--cx-fell);
        font-size: 0.86em;
        letter-spacing: 0.03em;
        color: var(--cx-rubric);
      }

      /* the versal */
      .cx-drop::first-letter {
        font-family: var(--cx-fell);
        float: left;
        font-size: 3.1em;
        line-height: 0.82;
        padding: 0.06em 0.1em 0 0;
        color: var(--cx-rubric);
      }

      .cx-catch {
        margin: 1.6rem 0 0;
        text-align: right;
        font-style: italic;
        font-size: 0.86rem;
        color: var(--cx-ink-4);
      }

      .cx-chap--two {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: clamp(30px, 5vw, 62px);
      }

      .cx-numbered { margin: 0; padding-left: 1.15rem; }
      .cx-numbered li { margin: 0 0 0.8rem; color: var(--cx-ink-2); }
      .cx-numbered li::marker { color: var(--cx-rubric); font-family: var(--cx-fell); }
      .cx-numbered b { color: var(--cx-ink); font-weight: 600; }

      /* ── the drolleries, in the margin where they belong ── */
      .cx-shelves { list-style: none; margin: 0; padding: 0; }
      .cx-shelves li {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 13px 0;
        border-top: 1px solid var(--cx-rule-soft);
      }
      .cx-shelves li:first-child { border-top: 0; padding-top: 4px; }
      .cx-shelves p { margin: 0; color: var(--cx-ink-2); font-size: 0.97rem; }
      .cx-shelves .dr { --dr-size: 50px; margin-top: -4px; }
      .cx-shelves li:hover .dr { color: var(--cx-rubric); }
      .cx-shelves .dr { transition: color 220ms ease; }

      .cx-caveats { margin: 0; }
      .cx-caveats > div { padding: 11px 0; border-top: 1px solid var(--cx-rule-soft); }
      .cx-caveats > div:first-child { border-top: 0; padding-top: 0; }
      .cx-caveats dt {
        font-family: var(--cx-fell);
        font-size: 0.86rem;
        letter-spacing: 0.03em;
        color: var(--cx-ink);
        margin-bottom: 0.15rem;
      }
      .cx-caveats dd { margin: 0; color: var(--cx-ink-3); font-size: 0.94rem; }

      /* ══════════ recipe ══════════ */
      .cx-recipe {
        list-style: none;
        counter-reset: motion;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: clamp(24px, 4vw, 42px);
        margin: 1.4rem 0 0;
        padding: 0;
      }
      .cx-recipe li { counter-increment: motion; }
      .cx-recipe h3 {
        font-family: var(--cx-fell);
        font-size: 0.95rem;
        font-weight: 400;
        letter-spacing: 0.05em;
        margin: 0 0 0.6rem;
      }
      .cx-recipe h3::before {
        content: counter(motion, upper-roman) ". ";
        color: var(--cx-rubric);
      }
      .cx-recipe pre {
        margin: 0 0 0.7rem;
        padding: 11px 13px;
        border: 1px solid var(--cx-rule);
        background: var(--cx-paper-2);
        overflow-x: auto;
        font-size: 0.78rem;
        line-height: 1.55;
      }
      .cx-recipe p { margin: 0; font-size: 0.92rem; color: var(--cx-ink-3); }

      /* ══════════ table ══════════ */
      .cx-table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.4rem 0 1rem;
        font-size: 0.9rem;
      }
      .cx-table thead th {
        font-family: var(--cx-fell);
        font-size: 0.66rem;
        font-weight: 400;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--cx-ink-4);
        text-align: left;
        padding: 0 12px 7px 0;
        border-bottom: 3px double var(--cx-rule);
      }
      .cx-table tbody th {
        font-family: var(--cx-fell);
        font-weight: 400;
        font-size: 0.95rem;
        text-align: left;
        white-space: nowrap;
      }
      .cx-table td, .cx-table tbody th {
        padding: 10px 12px 10px 0;
        border-bottom: 1px solid var(--cx-rule-soft);
        color: var(--cx-ink-2);
        vertical-align: baseline;
      }
      .cx-table tr.is-best th { color: var(--cx-rubric); }
      .cx-mark {
        display: inline-block;
        margin-left: 8px;
        font-family: var(--cx-fell);
        font-size: 0.58rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--cx-rubric);
        border: 1px solid currentColor;
        border-radius: 2px;
        padding: 1px 5px;
        vertical-align: 2px;
      }
      .cx-no { color: var(--cx-rubric); font-style: italic; }
      .cx-foot-note {
        font-size: 0.9rem;
        color: var(--cx-ink-3);
        max-width: var(--cx-measure);
        margin: 0;
      }

      .cx-chap--apology .cx-numbered { max-width: 44rem; }

      /* ══════════ colophon ══════════ */
      .cx-colophon {
        max-width: var(--cx-page);
        margin: 0 auto;
        padding: clamp(30px, 5vh, 52px) clamp(20px, 5vw, 34px) clamp(46px, 8vh, 78px);
        text-align: center;
      }
      .cx-orn {
        font-size: 1.2rem;
        color: var(--cx-rubric);
        margin: 0.8rem 0 1rem;
      }
      .cx-thanks {
        max-width: 36rem;
        margin: 0 auto 2rem;
        padding: 16px 20px;
        border: 1px solid var(--cx-rule);
        border-left: 3px double var(--cx-rubric);
        background: var(--cx-paper-2);
        font-size: 0.95rem;
        line-height: 1.62;
        color: var(--cx-ink-2);
        text-align: left;
        font-variation-settings: "opsz" 14;
      }
      .cx-thanks-t {
        font-family: var(--cx-fell);
        letter-spacing: 0.06em;
        color: var(--cx-rubric);
      }

      .cx-colo-body {
        max-width: 34rem;
        margin: 0 auto;
        font-size: 0.92rem;
        line-height: 1.66;
        color: var(--cx-ink-3);
        /* Small text takes the sturdier low-optical-size cut. */
        font-variation-settings: "opsz" 9;
      }
      .cx-colo-title {
        font-family: var(--cx-fell);
        letter-spacing: 0.06em;
        color: var(--cx-ink-2);
      }
      .cx-colo-body b { color: var(--cx-ink-2); font-weight: 600; }
      .cx-colo-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin-top: 1.6rem;
        font-family: var(--cx-fell);
        font-size: 0.7rem;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }
      .cx-colo-links a { color: var(--cx-ink-3); }
      .cx-colo-links a:hover { color: var(--cx-rubric); }

      /* ══════════ narrow leaves ══════════ */
      @media (max-width: 900px) {
        .cx-title { grid-template-columns: minmax(0, 1fr); }
        .cx-plate { order: -1; max-width: 24rem; margin: 0 auto; }
        .cx-cols { columns: 1; }
        .cx-head { grid-template-columns: 1fr auto; }
        .cx-head-c { display: none; }
      }
      @media (max-width: 520px) {
        .cx { font-size: 18px; }
        .cx-head-r { gap: 6px; }
      }
    </style>
  </body>
</html>
